#!/usr/bin/env bash
# SessionStart hook for Formless

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read the Formless entry skill.
feder_heben_content=$(cat "${PLUGIN_ROOT}/skills/feder-heben/SKILL.md" 2>&1 || echo "Error reading feder-heben skill")

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

feder_heben_escaped=$(escape_for_json "$feder_heben_content")
session_context="<EXTREMELY_IMPORTANT>\nRaise the quill. Formless is available.\n\n**Below is the full content of 'formless:feder-heben', the entry point for selecting a Formless workflow. Load other skills with the Skill tool only when their workflow applies:**\n\n${feder_heben_escaped}\n</EXTREMELY_IMPORTANT>"

# Output Claude Code SessionStart context as JSON.
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# See: https://github.com/obra/superpowers/issues/571
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat

exit 0
