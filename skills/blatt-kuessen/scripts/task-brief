#!/usr/bin/env bash
# Extract the plan-wide context and one task's full text into a file the
# implementer reads in one call, so requirements never have to be pasted
# through the controller's context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.formless/sdd/task-<NN>/brief.md
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [[ ! $n =~ ^[0-9]+$ ]]; then
  echo "task number must be a positive integer: $n" >&2
  exit 2
fi
if (( 10#$n < 1 )); then
  echo "task number must be a positive integer: $n" >&2
  exit 2
fi
task_id=$(printf '%02d' "$((10#$n))")

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
  out="$dir/task-${task_id}/brief.md"
fi

mkdir -p "$(dirname "$out")"

if ! awk -v n="$n" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ {
    sawtask = 1
    intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)"))
    if (intask) found = 1
  }
  !sawtask || intask { print }
  END { if (!found) exit 1 }
' "$plan" > "$out"; then
  : > "$out"
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
